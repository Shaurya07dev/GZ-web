# GalleryZone — the ONE env file. Copy to `.env` at the repo root (gitignored).
#   backend:  `npm start` in backend/ passes --env-file=../.env
#   website:  frontend-web/next.config.ts loads ../.env before build/dev
# On Vercel, set the NEXT_PUBLIC_* values in the project's Environment
# Variables instead; on the API host, set the backend values there.

# ---------------------------------------------------------------- website
# NestJS API base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Canonical public origin of the website. Baked into QR codes / certificate
# PDFs — in production this MUST be the real domain. NFC tags carry this host
# in their URL FOREVER once locked, so it must be the host the site is served
# from (www.galleryzone.art, not an apex that redirects) and must never change
# to one that doesn't redirect back. Do not lock a tag while this points at a
# temporary host: a locked chip is read-only for good and cannot be repointed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the mobile app is installed from (a store link). Shown as a QR in the
# "Link NFC tag" dialog on browsers that can't write tags. Leave blank until
# the app is on a store.
NEXT_PUBLIC_MOBILE_APP_URL=
# App Links / Universal Links (served at /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association). Server-side, NOT NEXT_PUBLIC_.
# Unset = the files are served empty and no app claims /verify/*.
#   ANDROID_APP_SHA256_FINGERPRINTS: signing key fingerprint(s), comma-separated,
#   AA:BB:... as `keytool -list -v` prints it. Use the Play App Signing key once on Play.
ANDROID_APP_PACKAGE=in.galleryzone.app
ANDROID_APP_SHA256_FINGERPRINTS=
#   IOS_APP_ID: <Apple Team ID>.<bundle id>
IOS_APP_ID=
# Firebase web app config (public by design — access is governed by
# Firebase Auth + the API's RolesGuard, not by hiding these).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=galleryzone-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=galleryzone-prod
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=galleryzone-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------- backend
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=galleryzone-prod
GCP_PROJECT_ID=galleryzone-prod
# Firebase Admin SDK service-account JSON — absolute path, file kept OUTSIDE
# the repo (or matched by backend/.gitignore's *firebase-adminsdk*.json).
# Firebase console -> Project settings -> Service accounts -> Generate key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/galleryzone-prod-firebase-adminsdk.json
# …or, on a hosted platform with no filesystem secret, the JSON itself:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Browser origins allowed by CORS, comma-separated. Add the Vercel domain.
CORS_ORIGINS=http://localhost:3000
# "simulated" lets a customer confirm their own order (a stand-in for the
# gateway webhook) and NO MONEY MOVES. Set to "razorpay" to take real
# payments; that also closes the simulate-payment route to customers, so a
# deploy can never ship free checkout. Leaving this unset means simulated in
# development and FAILS THE BOOT in production, where it is never an accident.
# Only "simulated" and "razorpay" are accepted: an unrecognised value (a stale
# "cashfree" from the one day the gateway was Cashfree, a typo) is refused
# rather than falling back, because falling back would open free checkout.
PAYMENTS_MODE=simulated

# --- Razorpay: the payment gateway -------------------------------------------
# dashboard.razorpay.com -> Account & Settings -> API Keys.
# Unset = checkout answers 503 instead of failing oddly.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A THIRD credential, and not the one above: you choose it yourself in
# Account & Settings -> Webhooks when registering the endpoint
# (POST /v1/payments/razorpay/webhook, events payment.captured, order.paid,
# payment.failed). It is the only thing that signs x-razorpay-signature.
# Unset = every webhook is rejected, which means a buyer who pays and then
# closes the tab is charged and never gets their order.
RAZORPAY_WEBHOOK_SECRET=

# --- Cashfree Secure ID: Aadhaar + GSTIN verification only --------------------
# Payments are Razorpay (client decision, 5 Oct 2026); Cashfree is kept solely
# for verification, so there are no Cashfree gateway keys here any more.
# "sandbox" (the default) or "production" — the base URL is derived from this,
# never hardcoded, so going live is one deliberate change.
CASHFREE_ENV=sandbox
# merchant.cashfree.com -> Developers -> API Keys, under the Secure ID card.
# Unset = the verification routes answer 503.
CASHFREE_VERIFICATION_APP_ID=
CASHFREE_VERIFICATION_SECRET_KEY=
# Secure ID enforces 2FA on EVERY call, and offers two ways to satisfy it:
# allow-list the caller's IP, or sign each request with a public key. Railway
# has no static outbound IP, so we sign.
#   merchant.cashfree.com -> Developers -> Two-Factor Authentication
#   (under the Secure ID card) -> Select 2FA Method = Public Key -> download
#   the .pem, and paste it here (raw PEM or its base64 both work).
# Use the OLDEST client id on the account for the keys above: Cashfree
# validates this signature against the first key pair ever issued, so a newer
# pair fails here specifically while working everywhere else.
# Unset = no X-Cf-Signature header is sent at all, which is correct ONLY if the
# account is on IP allow-listing instead (Cashfree rejects requests that send
# both). Either way, a missing factor means GSTIN and Aadhaar answer 503.
CASHFREE_VERIFICATION_PUBLIC_KEY=
REDIS_URL=
SENTRY_DSN=
# Web (Vercel): NEXT_PUBLIC_SENTRY_DSN for the browser/server SDK; SENTRY_ORG / SENTRY_PROJECT /
# SENTRY_AUTH_TOKEN only if source maps should be uploaded at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Who signs the artist and aggregator MOUs for Galleryzone Private Limited —
# fills "Name" and "Designation" under FOR GALLERYZONE PRIVATE LIMITED on every
# MOU signed from now on (recorded with each signature; changing it later does
# not alter MOUs already signed). Leave blank and those two lines stay empty.
MOU_SIGNATORY_NAME=
MOU_SIGNATORY_DESIGNATION=
# Email (Resend). EMAIL_FROM must be on a verified domain to reach anyone but the account owner.
RESEND_API_KEY=
EMAIL_FROM=GalleryZone <hello@galleryzone.art>
# Public URL of the website (links inside emails, QR codes).
PUBLIC_SITE_URL=https://www.galleryzone.art

# ── Artwork images (Railway bucket, S3-compatible) ────────────────────────
# On Railway these are reference variables to the bucket
# (${{artwork-images.BUCKET}} etc.). Locally, copy the values from the
# bucket's Credentials tab. Leave unset and the image routes return 503.
# Public base URL of the API (image URLs are built from it). Railway derives it from RAILWAY_PUBLIC_DOMAIN.
PUBLIC_API_URL=http://localhost:8080
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
