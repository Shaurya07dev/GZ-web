# GalleryZone — the ONE env file. Copy to `.env` at the repo root (gitignored).
#   backend:  `npm start` in backend/ passes --env-file=../.env
#   website:  frontend-web/next.config.ts loads ../.env before build/dev
# On Vercel, set the NEXT_PUBLIC_* values in the project's Environment
# Variables instead; on the API host, set the backend values there.

# ---------------------------------------------------------------- website
# NestJS API base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Canonical public origin of the website. Baked into QR codes / certificate
# PDFs — in production this MUST be the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase web app config (public by design — access is governed by
# Firebase Auth + the API's RolesGuard, not by hiding these).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=galleryzone-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=galleryzone-prod
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=galleryzone-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------- backend
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=galleryzone-prod
GCP_PROJECT_ID=galleryzone-prod
# Firebase Admin SDK service-account JSON — absolute path, file kept OUTSIDE
# the repo (or matched by backend/.gitignore's *firebase-adminsdk*.json).
# Firebase console -> Project settings -> Service accounts -> Generate key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/galleryzone-prod-firebase-adminsdk.json
# Browser origins allowed by CORS, comma-separated. Add the Vercel domain.
CORS_ORIGINS=http://localhost:3000
# "simulated" lets a customer confirm their own order (stand-in for the
# Razorpay webhook). Set to "razorpay" once the real webhook exists.
PAYMENTS_MODE=simulated
# Deferred integrations — leave blank until wired.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=
SENTRY_DSN=
