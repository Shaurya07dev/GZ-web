# Copy this file to .env in the same directory (backend/apps/api/.env)
# and fill in the placeholders below. .env is gitignored — never commit it.

NODE_ENV=development
PORT=8080

# --- Database / cache ---------------------------------------------------------
# Local Postgres 16 (see backend/packages/db/scripts/test-migrations.sh for
# how to spin one up in Docker) or your Cloud SQL instance once Phase 0
# infra exists.
DATABASE_URL=postgres://user:pass@localhost:5432/galleryzone
REDIS_URL=redis://localhost:6379

# --- Firebase --------------------------------------------------------------
# Project created via the Firebase MCP plugin (logged in as
# shaurya8851@gmail.com): https://console.firebase.google.com/project/galleryzone-prod
FIREBASE_PROJECT_ID=galleryzone-prod

# Admin SDK service-account key — needed for real ID-token verification
# (Phase 1's auth guard; not wired in yet, RolesGuard still 501s every
# protected route regardless of this value). The Firebase MCP tools can't
# generate this — it's a GCP Console step:
#   1. https://console.firebase.google.com/project/galleryzone-prod/settings/serviceaccounts/adminsdk
#   2. "Generate new private key" -> downloads a JSON file
#   3. Save it somewhere OUTSIDE this repo (e.g. ~/secrets/galleryzone-prod-admin.json)
#   4. Put its path here:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/galleryzone-prod-admin-sdk.json

# --- Razorpay (test mode) ---------------------------------------------------
# https://dashboard.razorpay.com -> ensure "Test Mode" toggle (top-left) is
# ON -> Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme

# Settings -> Webhooks -> Add New Webhook. URL can be a placeholder until
# apps/api is actually deployed somewhere reachable (Razorpay needs to be
# able to POST to it) — https://webhook.site gives you a throwaway URL to
# test the signature-verification code path locally in the meantime.
RAZORPAY_WEBHOOK_SECRET=changeme

# --- GCP ---------------------------------------------------------------------
# Same project as Firebase if you want one project for both (recommended,
# and how galleryzone-prod is already set up — Firebase projects ARE GCP
# projects under the hood).
GCP_PROJECT_ID=galleryzone-prod

# --- Observability -----------------------------------------------------------
# Optional — leave blank until Phase 0's Sentry account exists.
SENTRY_DSN=
