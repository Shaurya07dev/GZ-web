# Copy this file to .env in the same directory (backend/apps/api/.env)
# and fill in the placeholders below. .env is gitignored — never commit it.

NODE_ENV=development
PORT=8080

# --- Firebase (auth + database) ---------------------------------------------
# Project created via the Firebase MCP plugin (logged in as
# shaurya8851@gmail.com): https://console.firebase.google.com/project/galleryzone-prod
# Both auth and the database (Firestore) live in this one project.
FIREBASE_PROJECT_ID=galleryzone-prod
GCP_PROJECT_ID=galleryzone-prod

# Admin SDK service-account key — used for BOTH real ID-token verification
# (Phase 1's auth guard) and all Firestore reads/writes (the Admin SDK
# bypasses firestore.rules entirely; those rules only govern a client
# talking to Firestore directly). Generate at:
#   https://console.firebase.google.com/project/galleryzone-prod/settings/serviceaccounts/adminsdk
#   -> "Generate new private key" -> save the JSON OUTSIDE this repo
#      (it's already gitignored if you put it inside by mistake, but don't
#      rely on that) -> put its absolute path here:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/galleryzone-prod-admin-sdk.json

# --- HTTP ---------------------------------------------------------------------
# Browser origins allowed by CORS, comma-separated. Add the Vercel domain
# when the frontend is deployed.
CORS_ORIGINS=http://localhost:3000

# --- Payments mode ------------------------------------------------------------
# "simulated" (default) lets a customer confirm their own order via
# POST /v1/orders/:id/simulate-payment — a stand-in for the Razorpay
# webhook. Set to "razorpay" once the real webhook exists.
PAYMENTS_MODE=simulated

# --- Redis (optional — nothing uses it yet) -----------------------------------
# Reserved for rate limiting/caching per the plan. Leave blank until
# something actually connects to it.
REDIS_URL=

# --- Razorpay (deferred) -----------------------------------------------------
# Explicitly deferred per your own instruction — leave these blank.
# confirmSimulatedPayment() doesn't call Razorpay at all yet, so the app
# boots and runs fine without these. Fill in later when ready:
#   https://dashboard.razorpay.com -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability -----------------------------------------------------------
# Optional — leave blank until Phase 0's Sentry account exists.
SENTRY_DSN=
