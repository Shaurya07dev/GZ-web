{
  "name": "galleryzone-backend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:pricing": "node --experimental-strip-types packages/domain/src/pricing.check.ts",
    "check:state-machine": "node --experimental-strip-types packages/domain/src/state-machine.check.ts",
    "check:settlement": "node --experimental-strip-types packages/domain/src/settlement.check.ts",
    "check:price-leak": "node --experimental-strip-types packages/contracts/src/artwork-dto.check.ts",
    "check:policies": "node --experimental-strip-types packages/domain/src/policies.check.ts",
    "check:aggregator-cycle": "node --experimental-strip-types packages/domain/src/aggregator-cycle.check.ts",
    "check:api-routes": "node --experimental-strip-types packages/contracts/src/api-routes.check.ts",
    "check": "npm run check:pricing && npm run check:state-machine && npm run check:settlement && npm run check:price-leak && npm run check:policies && npm run check:aggregator-cycle && npm run check:api-routes"
  },
  "engines": {
    "node": ">=22.6"
  }
}
