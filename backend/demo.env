# Local demo stack: API + website against the Firestore/Auth EMULATORS. No secrets, no real project.
# Used by: node --env-file=demo.env (API), and exported into the shell for `next dev`.
# See scripts/seed-demo.ts for the data and `npm run demo:*` for the commands.
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=demo-gz
GCP_PROJECT_ID=demo-gz
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=http://localhost:3000
PAYMENTS_MODE=simulated

NEXT_PUBLIC_API_URL=http://localhost:8080
# No NEXT_PUBLIC_SITE_URL: QR codes and NFC links carry the public address
# (https://www.galleryzone.art/verify/<id>) even in the demo, exactly as in production.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gz
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
