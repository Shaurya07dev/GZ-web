# Copy to .env.local (gitignored). All of these are PUBLIC client config —
# the Firebase web API key identifies the project, it is not a secret; access
# is governed by Firebase Auth + the backend's RolesGuard, never by hiding it.

# NestJS API base URL (backend/apps/api). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public origin of THIS site. Baked into QR codes / certificate
# PDFs, so in production it must be the real domain, never localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config: Firebase console -> Project settings -> Your apps,
# or `npx firebase-tools apps:sdkconfig web --project galleryzone-prod`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=galleryzone-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=galleryzone-prod
NEXT_PUBLIC_FIREBASE_APP_ID=
