# Website-only repo: the Next.js site (frontend-web/) and its NestJS API
# (backend/). Everything else at the root is workspace scratch and stays
# untracked unless listed here.
/*
!/frontend-web/
!/backend/
!/docs/
!/.github/
!/.gitignore
!/.env.example
!/README.md

# The single env file lives at the root — never committed.
/.env
