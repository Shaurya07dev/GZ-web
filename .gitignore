# The whole product in one repo: the Next.js site (frontend-web/), its NestJS
# API (backend/) and the Flutter app (mobile/). Everything else at the root is
# workspace scratch and stays untracked unless listed here.
/*
!/frontend-web/
!/backend/
!/mobile/
!/docs/
!/.github/
!/.gitignore
!/README.md
# Kept deliberately: it holds no secrets and is the only inventory of the
# variables the API needs to boot. The real /.env below is what stays out.
!/.env.example

# The single env file lives at the root — never committed. The glob covers
# backups and variants too: a stray .env.bak holds the same live secrets.
/.env
/.env.*
.claude/skills/
